def load_posts():
    with open(POSTS_FILE, "r", encoding="utf-8") as f:
        return json.load(f)

def save_posts(data):
    with open(POSTS_FILE, "w", encoding="utf-8") as f:
        json.dump(data, f, ensure_ascii=False, indent=2)

def get_random_post():
    data = load_posts()
    posts = data["posts"]
^    unused = [p for p in posts if not p.get("used")]
    if not unused:
        for p in posts:
            p["used"] = False
        unused = posts
    post = random.choice(unused)
    post["used"] = True
    save_posts(data)
    return post["text"]

