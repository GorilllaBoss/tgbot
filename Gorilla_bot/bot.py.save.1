async def daily_post_loop():
    today = None
    plan = []
    sent = set()

    while True:
        now = datetime.now()

        if today != now.date():
            today = now.date()
            plan = generate_daily_schedule()
            sent.clear()
            save_json(POSTS_PLAN_FILE, {"date": today_key(), "plan": plan})

        t = now.strftime("%H:%M")
        if t in plan and t not in sent:
            last = get_last_post_time()
            if not last or now - last >= MIN_POST_INTERVAL:
                text = get_random_post()
                await bot.send_message(DAILY_POST_CHAT_ID, text)
                sent.add(t)
                set_last_post_time(now)
                update_post_stats(text, t)

        await asyncio.sleep(30)

# =======================
# REMINDER LOOP
# =======================

async def reminder_loop():
    while True:
        now = datetime.now()
        reminders = load_json(REMINDERS_FILE, [])
        changed = False
        for r in reminders:
            if r["sent"] or not r["time"]:
                continue
            if datetime.fromisoformat(r["time"]) <= now:
                await bot.send_message(r["user_id"], f"⏰ {r['text']}")
                r["sent"] = True
                changed = True
        if changed:
            save_json(REMINDERS_FILE, reminders)
        await asyncio.sleep(30)

# =======================
# RUN
# =======================

async def main():
    asyncio.create_task(reminder_loop())
    asyncio.create_task(daily_post_loop())
    await dp.start_polling(bot)

if __name__ == "__main__":
    asyncio.run(main())
