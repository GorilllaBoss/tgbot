# =======================
# INTENTS
# =======================

def is_reminder_intent(text: str) -> bool:
    return any(w in text.lower() for w in ["напомни", "напомин", "уведом"])

def is_goal_intent(text: str) -> bool:
    return any(w in text.lower() for w in ["цель", "хочу", "задача"])

# =======================
# TIME
# =======================

def smart_time(text: str) -> Optional[datetime]:
    try:
        parsed = dateparser.parse(text, dayfirst=True, fuzzy=True)
        if parsed:
            if parsed < datetime.now():
                parsed += timedelta(days=1)
            return parsed
    except:
        pass
    return None

# =======================
# CONTEXT
# =======================

def set_context(user_id: int, ctx: str):
    data = load_json(CONTEXT_FILE, {})
    data[str(user_id)] = ctx
    save_json(CONTEXT_FILE, data)

def get_context(user_id: int) -> str:
    return load_json(CONTEXT_FILE, {}).get(str(user_id), "GORILLA")

def prompt_by_context(ctx: str) -> str:
    return {
        "GORILLA": prompts.GORILLA,
        "GARDEN": prompts.GARDEN,
        "BODY": prompts.BODY
    }.get(ctx, prompts.GORILLA)

# =======================
# COMMANDS
# =======================

@dp.message(CommandStart())
async def start(msg: types.Message):
    set_context(msg.from_user.id, "GORILLA")
    await msg.answer("Я Gorilla 🦍", reply_markup=keyboard)

@dp.message(lambda m: m.text in ["🦍 Gorilla", "🌱 Сад", "💪 Тело"])
async def switch_context(msg: types.Message):
    mapping = {
        "🦍 Gorilla": "GORILLA",
        "🌱 Сад": "GARDEN",
        "💪 Тело": "BODY"
    }
    set_context(msg.from_user.id, mapping[msg.text])
    await msg.answer(f"Фокус: {msg.text}", reply_markup=keyboard)

