# =======================
# JSON HELPERS
# =======================

def load_json(path, default):
    if not os.path.exists(path):
        return default
    try:
        with open(path, "r", encoding="utf-8") as f:
            text = f.read().strip()
            return json.loads(text) if text else default
    except:
        return default

def save_json(path, data):
    with open(path, "w", encoding="utf-8") as f:
        json.dump(data, f, ensure_ascii=False, indent=2)

# =======================
# MEMORY (ADD, SAFE)
# =======================

def remember(user_id: int, context: str, text: str):
    memory = load_json(MEMORY_FILE, {})
    uid = str(user_id)

    memory.setdefault(uid, {"common": [], "contexts": {}})
    memory[uid]["contexts"].setdefault(context, [])

    entry = {
        "text": text,
        "time": datetime.now().isoformat()
    }

    if len(text) > 20:
        memory[uid]["contexts"][context].append(entry)
        if context != "GORILLA":
            memory[uid]["common"].append(entry)

    save_json(MEMORY_FILE, memory)

def recall(user_id: int, context: str, limit=6):
    memory = load_json(MEMORY_FILE, {})
    uid = str(user_id)

    if uid not in memory:
        return []

    result = []
    result.extend(memory[uid]["common"][-limit:])

    if context in memory[uid]["contexts"]:
        result.extend(memory[uid]["contexts"][context][-limit:])

    return result[-limit:]

# =======================
# AUTOPST STATE
# =======================

MIN_POST_INTERVAL = timedelta(hours=4)

def get_last_post_time() -> Optional[datetime]:
    state = load_json(POSTS_STATE_FILE, {})
    t = state.get("last_post_time")
    return datetime.fromisoformat(t) if t else None

def set_last_post_time(dt: datetime):
    save_json(POSTS_STATE_FILE, {"last_post_time": dt.isoformat()})

# =======================
# STATS
# =======================

def today_key():
    return datetime.now().strftime("%Y-%m-%d")

def init_stats():
    return {"total_sent": 0, "days": {}}

def update_post_stats(text: str, time_str: str):
    stats = load_json(POSTS_STATS_FILE, init_stats())
    day = today_key()
    stats["days"].setdefault(day, []).append({
        "time": time_str,
        "text": text,
        "channel": DAILY_POST_CHAT_ID
    })
    stats["total_sent"] += 1
    save_json(POSTS_STATS_FILE, stats)

