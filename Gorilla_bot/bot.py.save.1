@dp.message(lambda m: m.text == "🎯 Цели")
async def show_goals(msg: types.Message):
    goals = load_json(GOALS_FILE, [])
    user_goals = [g for g in goals if g["user_id"] == msg.from_user.id]
    if not user_goals:
        await msg.answer("🎯 Целей нет")
        return
    for i, g in enumerate(user_goals):
        kb = InlineKeyboardMarkup(inline_keyboard=[[
            InlineKeyboardButton(text="✏️", callback_data=f"edit:goal:{i}"),
            InlineKeyboardButton(text="❌", callback_data=f"delete:goal:{i}")
        ]])
        await msg.answer(g["text"], reply_markup=kb)

@dp.message(lambda m: m.text == "⏰ Напоминания")
async def show_reminders(msg: types.Message):
    reminders = load_json(REMINDERS_FILE, [])
    user_items = [r for r in reminders if r["user_id"] == msg.from_user.id]
    if not user_items:
        await msg.answer("⏰ Напоминаний нет")
        return
    for i, r in enumerate(user_items):
        kb = InlineKeyboardMarkup(inline_keyboard=[[
            InlineKeyboardButton(text="✏️", callback_data=f"edit:reminder:{i}"),
            InlineKeyboardButton(text="❌", callback_data=f"delete:reminder:{i}")
        ]])
        await msg.answer(r["text"], reply_markup=kb)

# =======================
# CALLBACKS
# =======================

@dp.callback_query()
async def callback_router(cb: CallbackQuery):
    data = cb.data
    user_id = cb.from_user.id
    edit_state = load_json(EDIT_STATE_FILE, {})

    if ":" not in data:
        return

    action, item_type, idx = data.split(":")
    idx = int(idx)

    if action == "delete":
        file = GOALS_FILE if item_type == "goal" else REMINDERS_FILE
        items = load_json(file, [])
        user_items = [x for x in items if x["user_id"] == user_id]
        if idx < len(user_items):
            items.remove(user_items[idx])
            save_json(file, items)
        await cb.message.edit_text("❌ Удалено")
        return

    if action == "edit":
        edit_state[str(user_id)] = {"type": item_type, "index": idx}
        save_json(EDIT_STATE_FILE, edit_state)
        await cb.message.answer("✏️ Введите новый текст:")

# =======================
# MAIN HANDLER
# =======================

@dp.message()
async def handle(msg: types.Message):
    text = msg.text.strip()
    user_id = msg.from_user.id
    ctx = get_context(user_id)

    remember(user_id, ctx, text)

    edit_state = load_json(EDIT_STATE_FILE, {})
    if str(user_id) in edit_state:
        state = edit_state.pop(str(user_id))
        save_json(EDIT_STATE_FILE, edit_state)
        file = GOALS_FILE if state["type"] == "goal" else REMINDERS_FILE
        items = load_json(file, [])
        count = -1
        for item in items:
            if item["user_id"] == user_id:
                count += 1
                if count == state["index"]:
                    item["text"] = text
                    break
        save_json(file, items)
        await msg.answer("✅ Обновлено")
        return

    if is_reminder_intent(text):
        t = smart_time(text)
        reminders = load_json(REMINDERS_FILE, [])
        reminders.append({
            "user_id": user_id,
            "text": text,
            "time": t.isoformat() if t else None,
            "sent": False
        })
        save_json(REMINDERS_FILE, reminders)
        await msg.answer("⏰ Напоминание сохранено")
        return

    if is_goal_intent(text):
        goals = load_json(GOALS_FILE, [])
        goals.append({"user_id": user_id, "text": text})
        save_json(GOALS_FILE, goals)
        await msg.answer("🎯 Цель сохранена")
        return

    memory = recall(user_id, ctx)
    memory_text = "\n".join(f"- {m['text']}" for m in memory)

    resp = client.chat.completions.create(
        model="openai/gpt-4o-mini",
        messages=[
            {
                "role": "system",
                "content": prompt_by_context(ctx) + "\n\nПАМЯТЬ:\n" + memory_text
            },
            {"role": "user", "content": text}
        ],
        temperature=0.4
    )

    await msg.answer(resp.choices[0].message.content)

